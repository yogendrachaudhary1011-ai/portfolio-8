{
  "entities": {
    "PortfolioContent": {
      "title": "PortfolioContent",
      "description": "Customizable content for the portfolio website",
      "type": "object",
      "properties": {
        "name": { "type": "string", "maxLength": 100 },
        "title": { "type": "string", "maxLength": 150 },
        "tagline": { "type": "string", "maxLength": 300 },
        "bio": { "type": "string", "maxLength": 1000 },
        "location": { "type": "string", "maxLength": 100 },
        "email": { "type": "string", "maxLength": 120 },
        "phone": { "type": "string", "maxLength": 50 },
        "linkedin": { "type": "string", "maxLength": 200 },
        "resumeUrl": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["name", "title", "email"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Registered administrator",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin", "superadmin"] },
        "createdAt": { "type": "string", "maxLength": 60 }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/portfolio/main": {
      "schema": { "$ref": "#/entities/PortfolioContent" },
      "description": "The primary customizable content document for the portfolio website"
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Administrator roles collection"
    }
  }
}
