{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/content", "destination": "/api/content" },
    { "source": "/perro", "destination": "/perro.html" },
    { "source": "/perro-deepdive", "destination": "/perro-deepdive.html" },
    { "source": "/mercore", "destination": "/mercore.html" },
    { "source": "/vedic-sewa", "destination": "/perro-deepdive.html" },
    { "source": "/somtu", "destination": "/mercore.html" },
    { "source": "/numira", "destination": "/perro.html" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/resume", "destination": "/assets/aistudio/Yogendra_Chaudhary_CV_cc247373.pdf" },
    { "source": "/about", "destination": "/index.html" },
    { "source": "/work", "destination": "/index.html" },
    { "source": "/projects", "destination": "/index.html" },
    { "source": "/contact", "destination": "/index.html" },
    { "source": "/process", "destination": "/index.html" },
    { "source": "/experience", "destination": "/index.html" },
    { "source": "/404", "destination": "/index.html" },
    { "source": "/404.html", "destination": "/index.html" }
  ]
}
